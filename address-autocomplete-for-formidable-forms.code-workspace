			"commands": [
				{
					"match": ".*/address-autocomplete-for-formidable-forms/assets/(js/.*\\.js|scss/.*\\.scss)$",
					"cmd": "npm run build",
					"isAsync": false,
					"autoShowOutputPanel": "error"
