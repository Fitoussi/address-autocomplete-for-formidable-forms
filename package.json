{
	"name": "address-autocomplete-for-formidable-forms",
	"version": "1.0.0",
	"description": "Google Places address autocomplete for Formidable Forms",
	"scripts": {
		"test": "npm run test:php && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/js/*.test.mjs",
		"test:php": "php tests/contracts.php && php tests/activation-notice.php && php tests/overview.php && php tests/bootstrap-conflict.php",
		"package": "npm run build && php tools/package/build.php",
		"build": "npm run css && node build.js",
		"css": "sass assets/scss/admin/frmgeo-admin.scss:build/css/admin/frmgeo-admin.css assets/scss/admin/frmgeo-product-dashboard.scss:build/css/admin/frmgeo-product-dashboard.css --no-source-map && sass assets/scss/admin/frmgeo-admin.scss:build/css/admin/frmgeo-admin.min.css assets/scss/admin/frmgeo-product-dashboard.scss:build/css/admin/frmgeo-product-dashboard.min.css --style=compressed --no-source-map",
		"watch": "chokidar 'assets/js/**/*.js' -c 'node build.js'"
	},
	"devDependencies": {
		"chokidar-cli": "^3.0.0",
		"esbuild": "^0.19.0",
		"jsdom": "20.0.3",
		"npm-run-all": "^4.1.5",
		"sass": "^1.69.5",
		"jquery": "3.7.1"
	}
}
